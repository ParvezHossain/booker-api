DATABASE_URL=jdbc:postgresql://localhost:5432/android
DATABASE_USERNAME=admin
DATABASE_PASSWORD=your_database_password_here
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

BOOK_MAX_FILE_SIZE=200MB
BOOK_MAX_REQUEST_SIZE=201MB
BOOK_WORKSPACE_STORAGE_LIMIT=5GB
BOOK_MAX_PAGES=20000
BOOK_STORAGE_DIRECTORY=./data/books
SSE_MAX_CONNECTIONS=200
SSE_POLL_MILLIS=1000

# Set false when running locally without an OTLP collector.
MANAGEMENT_OTLP_METRICS_EXPORT_ENABLED=true

GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:4200/api/integrations/google-drive/callback
# Generate a separate key with openssl rand -base64 32; keep stable across restarts.
GOOGLE_DRIVE_ENCRYPTION_KEY=
# Public browser key restricted to Picker API, frontend origins, and https://docs.google.com/*.
GOOGLE_DRIVE_PICKER_API_KEY=
GOOGLE_DRIVE_PROJECT_NUMBER=

# Set both for initial setup. Use a dedicated email; never use a workspace owner email.
# Password: 12–64 characters. Remove these bootstrap values after provisioning.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# SMTP for password recovery, Super Admin book-request alerts, and requester decisions
# PASSWORD_RESET_URL is optional: blank emails a copyable token for Swagger/Android.
# Set an HTTPS frontend/app-link reset URL to email a link instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# Request mail sender: explicit value, then PASSWORD_RESET_FROM, then SMTP_USERNAME.
# Set explicitly when the SMTP username is not a provider-approved email address.
BOOK_REQUEST_EMAIL_FROM=
PASSWORD_RESET_FROM=
PASSWORD_RESET_URL=
# Optional email button to the backend copy helper. Use your reachable HTTPS origin.
# HTTP localhost/private LAN origins are permitted only for local development.
PASSWORD_RESET_TOKEN_PAGE_URL=
# IANA timezone for email expiry display. The browser helper uses the device timezone.
PASSWORD_RESET_TIME_ZONE=Asia/Dhaka
PASSWORD_RESET_TTL=PT30M
# Successful resets per account per UTC calendar month; positive integer.
PASSWORD_RESET_MONTHLY_LIMIT=3

# RabbitMQ request/decision emails; keep secrets backend-only.
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=booker
RABBITMQ_PASSWORD=your_rabbitmq_password_here
RABBITMQ_VHOST=/
RABBITMQ_SSL_ENABLED=false
BOOK_REQUEST_EMAIL_ENABLED=true
BOOK_REQUEST_EMAIL_QUEUE=booker.request-emails
BOOK_REQUEST_EMAIL_POLL_MILLIS=1000
BOOK_REQUEST_EMAIL_BATCH_SIZE=20
BOOK_REQUEST_EMAIL_QUEUE_LIMIT=1000
BOOK_REQUEST_EMAIL_MAX_ATTEMPTS=5
BOOK_REQUEST_EMAIL_RETRY_SECONDS=30
BOOK_REQUEST_EMAIL_REDISPATCH_SECONDS=300
